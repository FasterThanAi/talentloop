# Application Environment
APP_ENV=development
# Database Connection URI (PostgreSQL with pgvector, or SQLite for local dev)
DATABASE_URL=sqlite:///./talentloop.db
# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# --- Groq: automatic fallback when Gemini hits its quota -------------------------
# The Gemini free tier allows very few generate_content requests per day, which is
# enough to break a live demo. If Gemini returns 429/quota, the client fails over to
# Groq immediately. Leave GROQ_API_KEY unset to disable the fallback.
# Check current model names at https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Order providers are tried in. Swap to "groq,gemini" to make Groq primary.
AI_PROVIDER_ORDER=gemini,groq
# Gmail OAuth Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/gmail/callback
# Sign in with Google (identity). Same OAuth client as above, different scopes.
# BOTH redirect URIs must be registered in Google Cloud Console → Credentials.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
# Where the backend sends the browser after a successful Google sign-in.
FRONTEND_URL=http://localhost:5173
# JWT and Encryption Secrets
JWT_SECRET=super-secret-jwt-key-talentloop-dev-2026-very-secure
ENCRYPTION_KEY=D7hQk1rWJg9bNf-e6Y8X3uZ4lKv0Mo5Pq2sTtAa_V1c=
# Feature Flags
HUNTER_ENABLED=false
RIZEOS_ENABLED=false
CREDENTIAL_ANCHOR_ENABLED=false
