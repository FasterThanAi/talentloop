# Application Environment
APP_ENV=development
# Database Connection URI (PostgreSQL with pgvector, or SQLite for local dev)
DATABASE_URL=sqlite:///./talentloop.db
# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
# Gmail OAuth Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/gmail/callback
# JWT and Encryption Secrets
JWT_SECRET=super-secret-jwt-key-talentloop-dev-2026-very-secure
ENCRYPTION_KEY=D7hQk1rWJg9bNf-e6Y8X3uZ4lKv0Mo5Pq2sTtAa_V1c=
# Feature Flags
HUNTER_ENABLED=false
RIZEOS_ENABLED=false
CREDENTIAL_ANCHOR_ENABLED=false
